# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- environments / secrets ---
.venv/
venv/
.env
.env.*
!.env.example

# --- large / generated data (never committed; anchored to the repo root so package dirs like src/b20mlip/dft/ are not ignored) ---
/data/raw/
/data/frames/
/data/omat24/
/runs/
/models/
/dft/
/checkpoints/
/logs/
/cassettes/
*.duckdb
*.lmdb
*.aselmdb
*.model
*.pt
*.traj

# reports/ is generated but reports/numbers.json is TRACKED (README numbers come from it),
# and so are the provenance snapshots (manifest.json + numbers.json of every cited run) that
# `b20mlip report build` writes so `report audit --strict` can verify them in CI without runs/.
reports/*
!reports/numbers.json
!reports/manifests/
!reports/manifests/**

# --- editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# agent eval artefacts (gold depends on model + config; regenerated by `b20mlip screen`)
/evals/gold_*.json
/evals/refs/
