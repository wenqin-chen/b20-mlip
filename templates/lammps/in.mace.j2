{#- in.mace.j2 — LAMMPS MD with the ML-MACE package (ACEsuit/lammps `mace` branch), rendered by
    b20mlip.md.lammps.render_input. The pair_style / pair_coeff / atom_modify / newton lines follow
    https://mace-docs.readthedocs.io/en/latest/guide/lammps.html (checked 2026-09-18):
    `pair_style mace no_domain_decomposition` (single GPU, or one MPI rank with threads) and
    `pair_coeff * * <model>-lammps.pt <elements in LAMMPS type order>`. Units are metal (eV, Å, ps):
    timestep_ps = cfg.md.timestep_fs / 1000; Tdamp = 100*dt, Pdamp = 1000*dt (LAMMPS' own
    recommendation; the ASE run uses cfg.md.taut/taup, which changes no equilibrium average).
    The first comment line is a machine-readable header that b20mlip.md.lammps.parse_thermo reads
    back from the log (LAMMPS echoes the input). -#}
# b20mlip-md engine=lammps compound={{ compound }} ensemble={{ ensemble }} T={{ T }} timestep_fs={{ timestep_fs }} equil_steps={{ equil_steps }} steps={{ steps }} reps={{ reps }} natoms_per_cell={{ natoms_per_cell }} natoms={{ natoms }} head={{ head }} model_label={{ model_label }} model_sha256={{ model_sha256 }} seed={{ seed }}
# rendered from templates/lammps/in.mace.j2 (b20mlip.md.lammps.render_input); ML-MACE syntax per
# https://mace-docs.readthedocs.io/en/latest/guide/lammps.html
units           metal
atom_style      atomic
atom_modify     map yes
newton          on
boundary        p p p
read_data       data.lmp

pair_style      mace no_domain_decomposition
pair_coeff      * * {{ model_lammps }} {{ elements | join(' ') }}

timestep        {{ timestep_ps }}
velocity        all create {{ T }} {{ seed }} mom yes dist gaussian
{% if ensemble == 'npt' %}
fix             1 all npt temp {{ T }} {{ T }} $(100*dt) iso 0 0 $(1000*dt)
{% elif ensemble == 'nvt' %}
fix             1 all nvt temp {{ T }} {{ T }} $(100*dt)
{% else %}
fix             1 all nve
{% endif %}

thermo_style    custom step temp pe ke etotal press vol lx
thermo_modify   format float %.10g
thermo          {{ thermo_every }}
{% if equil_steps > 0 %}
# equilibration ({{ equil_steps }} steps = cfg.md.equil_ps); excluded from every average by parse_thermo
run             {{ equil_steps }}
{% endif %}
dump            1 all custom {{ dump_every }} dump.lammpstrj id type x y z vx vy vz
dump_modify     1 sort id
# production
run             {{ steps }}
write_data      final.data
