# Copy to .env (gitignored) or export in the shell. Every B20_ variable maps to a Settings key:
# B20_<SECTION>__<KEY>[__<SUBKEY>] (case-insensitive; lists/dicts as JSON).
# Merge order: configs/default.yaml -> --config YAMLs -> these -> --set key=value.

# --- paths / compute ---
B20_PATHS__DATA_DIR=data
B20_PATHS__RUNS_DIR=runs
B20_COMPUTE__THREADS=6
B20_COMPUTE__DTYPE=float64

# --- cluster (normally discovered by `b20mlip cluster bootstrap` into configs/cluster/tillicum.yaml) ---
# B20_CLUSTER__ALIAS=tillicum
# B20_CLUSTER__CONTROL_PATH=~/.ssh/tillicum-cm
# B20_CLUSTER__ACCOUNT=
# B20_CLUSTER__SCRATCH=

# --- agent: leave unset in CI; with no key the mock backend is enforced ---
# ANTHROPIC_API_KEY=
# B20_AGENT__BACKEND=mock

# --- optional enrichment only (SPEC.md section 2: no MP API key dependency) ---
# MP_API_KEY=
